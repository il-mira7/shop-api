# реальный .env создаёте из этого файла: cp .env.example .env
# миграции обоих сервисов накатываются автоматически при старте

# магазин
DATABASE_URL=postgres://user:password@localhost:5432/shopapi?sslmode=disable

# gRPC-сервис авторизации (своя БД)
AUTH_DATABASE_URL=postgres://user:password@localhost:5432/auth_db?sslmode=disable
AUTH_GRPC_PORT=50051

# секрет для подписи JWT, команда для генерации: openssl rand -base64 32
JWT_SECRET=change-me
